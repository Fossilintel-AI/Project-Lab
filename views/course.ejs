<!-- Confirm Assignment Start Modal -->
<div class="modal fade" id="confirmStartModal" tabindex="-1" aria-labelledby="confirmStartLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="confirmStartLabel">Start Assignment?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Once you open this assignment, you can't go back or retake it. Do you want to begin?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmStartBtn">Yes, Begin</button>
            </div>
        </div>
    </div>
</div>

<script>
    //viewing java
    let selectedAssignmentFilename = "";

    async function viewAssignment(filename) {
        selectedAssignmentFilename = filename.replace(/\.json$/i, '');

        // 🔍 Check deadline before showing modal
        const subject = '<%= subject %>';
        const response = await fetch(`/assignments/info/${selectedAssignmentFilename}`);
        const result = await response.json();

        if (result.status === 'late') {
            // ⏰ Past deadline – auto submit with grade 0
            const submitResponse = await fetch(`/assignments/force-submit/${selectedAssignmentFilename}`, {
                method: "POST"
            });

            if (submitResponse.ok) {
                const modalHtml = `
                <div class="modal fade" id="deadlineModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-warning text-dark">
                                <h5 class="modal-title">Deadline Passed</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>The deadline for this assignment has passed. A submission with a grade of 0 has been recorded automatically.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">OK</button>
                            </div>
                        </div>
                    </div>
                </div>`;
                document.body.insertAdjacentHTML('beforeend', modalHtml);
                const deadlineModal = new bootstrap.Modal(document.getElementById('deadlineModal'));
                deadlineModal.show();
            }
        } else {
            // 🟢 Show confirm start modal
            const modal = new bootstrap.Modal(document.getElementById('confirmStartModal'));
            modal.show();
        }
    }


    document.getElementById("confirmStartBtn").addEventListener("click", async function () {
        const subject = '<%= subject %>';
        const cleanFilename = selectedAssignmentFilename;

        // Hide modal
        const modalEl = document.getElementById('confirmStartModal');
        const modalInstance = bootstrap.Modal.getInstance(modalEl);
        modalInstance.hide();

        // Check if already attempted
        const response = await fetch(`/assignments/check/${cleanFilename}`);
        const result = await response.json();

        if (result.attempted) {
            alert("You have already attempted this assignment. You cannot access it again.");
            return;
        }

        sessionStorage.setItem(`started-${cleanFilename}`, Date.now());
        window.location.href = `/Course/${subject}/assignments/${encodeURIComponent(cleanFilename)}`;
    });

    function deleteAssignment(filename) {
        if (confirm('Are you sure you want to delete this assignment?')) {
            fetch(`/course/<%= subject %>/assignments/${filename}`, {
                method: 'DELETE'
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + (data.message || 'Failed to delete assignment'));
                    }
                })
                .catch(err => {
                    console.error("Error deleting assignment:", err);
                    alert('Failed to delete assignment');
                });
        }
    }



    // Assignment-related JavaScript
    const existingAssignment = <%- JSON.stringify(existingAssignment || null) %>;
    const assignmentFilename = "<%= filename || '' %>";
    let questionIndex = 0;

    function showCreateAssignmentModal() {
        document.getElementById('questions').innerHTML = '';
        questionIndex = 0;
        document.getElementById('assignmentTitle').value = '';

        if (existingAssignment && existingAssignment.questions) {
            document.getElementById("assignmentTitle").value = existingAssignment.title || "";
            existingAssignment.questions.forEach(q => addQuestion(q));
        }

        document.getElementById('createAssignmentModal').style.display = 'block';
    }

    function addQuestion(existing = null) {
        const container = document.getElementById("questions");
        const qDiv = document.createElement("div");
        qDiv.className = "question-block";
        qDiv.dataset.index = questionIndex;
        qDiv.id = `question-${questionIndex}`;

        const type = existing?.type || "mcq";
        const questionText = existing?.question || "";
        const marks = existing?.marks || "";

        qDiv.innerHTML = `
            <div class="question-header">
                <h5>Question ${questionIndex + 1}</h5>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeQuestion(${questionIndex})">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
            <div class="form-group">
                <label>Question Type:</label>
                <select class="form-control" name="questions[${questionIndex}][type]" onchange="updateOptions(this)">
                    <option value="mcq" ${type === "mcq" ? "selected" : ""}>Multiple Choice</option>
                    <option value="truefalse" ${type === "truefalse" ? "selected" : ""}>True/False</option>
                    <option value="written" ${type === "written" ? "selected" : ""}>Written Answer</option>
                </select>
            </div>
            <div class="form-group">
                <label>Question:</label>
                <textarea class="form-control" name="questions[${questionIndex}][question]" rows="3" required>${questionText}</textarea>
            </div>
            <div class="options"></div>
            <div class="form-group">
                <label>Marks:</label>
                <input type="number" class="form-control" name="questions[${questionIndex}][marks]" value="${marks}" required>
            </div>
        `;

        container.appendChild(qDiv);
        const optionsDiv = qDiv.querySelector(".options");
        addOptionsBlock(optionsDiv, type, questionIndex, existing);
        questionIndex++;
    }

    function removeQuestion(index) {
        const question = document.getElementById(`question-${index}`);
        if (question) {
            question.remove();
        }
    }

    function updateOptions(select) {
        const block = select.closest(".question-block");
        const index = block.dataset.index;
        const optionsDiv = block.querySelector(".options");
        optionsDiv.innerHTML = "";
        addOptionsBlock(optionsDiv, select.value, index);
    }

    function addOptionsBlock(container, type, qIndex, existing = null) {
        if (type === "mcq") {
            const opts = existing?.options || [];
            const correct = existing?.correct || "A";
            let html = `<div class="form-group">
                <label>Options:</label>
                <div class="option-list" id="option-list-${qIndex}">`;

            for (let i = 0; i < Math.max(opts.length, 2); i++) {
                html += renderLabeledOption(qIndex, i, opts[i] || "");
            }

            html += `</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addOption(${qIndex})">
                    <i class="fas fa-plus"></i> Add Option
                </button>
                <div class="form-group mt-2">
                    <label>Correct Answer:</label>
                    <select class="form-control" name="questions[${qIndex}][correct]" id="correct-select-${qIndex}" required>`;

            for (let i = 0; i < Math.max(opts.length, 2); i++) {
                const letter = String.fromCharCode(65 + i);
                html += `<option value="${letter}" ${correct === letter ? "selected" : ""}>${letter}</option>`;
            }

            html += `</select>
                </div>
            </div>`;
            container.innerHTML = html;
        } else if (type === "truefalse") {
            const correct = existing?.correct || "True";
            container.innerHTML = `
                <div class="form-group">
                    <label>Options:</label>
                    <ul class="list-unstyled">
                        <li>A. True</li>
                        <li>B. False</li>
                    </ul>
                </div>
                <div class="form-group">
                    <label>Correct Answer:</label>
                    <select class="form-control" name="questions[${qIndex}][correct]" required>
                        <option value="True" ${correct === "True" ? "selected" : ""}>True</option>
                        <option value="False" ${correct === "False" ? "selected" : ""}>False</option>
                    </select>
                </div>
            `;
        } else {
            container.innerHTML = ""; // Written answer has no options or correct answer
        }
    }

    function renderLabeledOption(qIndex, optIndex, value = "") {
        const letter = String.fromCharCode(65 + optIndex);
        return `
            <div class="input-group mb-2">
                <div class="input-group-prepend">
                    <span class="input-group-text">${letter}.</span>
                </div>
                <input type="text" class="form-control" name="questions[${qIndex}][options][]" value="${value}"
                       oninput="refreshCorrectOptions(${qIndex})" required>
            </div>`;
    }

    function addOption(qIndex) {
        const list = document.getElementById(`option-list-${qIndex}`);
        const count = list.querySelectorAll("input").length;
        const letter = String.fromCharCode(65 + count);

        const optionDiv = document.createElement('div');
        optionDiv.className = 'input-group mb-2';
        optionDiv.innerHTML = `
            <div class="input-group-prepend">
                <span class="input-group-text">${letter}.</span>
            </div>
            <input type="text" class="form-control" name="questions[${qIndex}][options][]"
                   oninput="refreshCorrectOptions(${qIndex})" required>
        `;

        list.appendChild(optionDiv);
        refreshCorrectOptions(qIndex);
    }

    function refreshCorrectOptions(qIndex) {
        const list = document.getElementById(`option-list-${qIndex}`);
        const inputs = list.querySelectorAll("input");
        const select = document.getElementById(`correct-select-${qIndex}`);
        if (!select) return;
        select.innerHTML = "";
        inputs.forEach((input, i) => {
            const letter = String.fromCharCode(65 + i);
            const option = document.createElement("option");
            option.value = letter;
            option.textContent = letter;
            select.appendChild(option);
        });
    }

    function toggleDurationInput() {
        const isTimed = document.getElementById('isTimed').value;
        const durationGroup = document.getElementById('durationGroup');
        durationGroup.style.display = isTimed === 'yes' ? 'block' : 'none';
    }


    function submitAssignment() {
        const title = document.getElementById('assignmentTitle').value;
        const filename = document.getElementById('filename').value;
        const subject = '<%= subject %>';
        const deadline = document.getElementById('deadline').value;
        const isTimed = document.getElementById('isTimed').value === 'yes';
        const timeLimit = isTimed ? parseInt(document.getElementById('timeLimit').value) : null;

        const questions = [];
        for (let i = 0; i < questionIndex; i++) {
            const block = document.getElementById(`question-${i}`);
            if (!block) continue;
            const type = block.querySelector(`select[name="questions[${i}][type]"]`).value;
            const question = block.querySelector(`textarea[name="questions[${i}][question]"]`).value;
            const marks = parseInt(block.querySelector(`input[name="questions[${i}][marks]"]`).value);
            let options = [];
            let correct = null;

            if (type === "mcq") {
                const optionInputs = block.querySelectorAll(`input[name="questions[${i}][options][]"]`);
                optionInputs.forEach(input => options.push(input.value));
                correct = block.querySelector(`select[name="questions[${i}][correct]"]`).value;
            } else if (type === "truefalse") {
                correct = block.querySelector(`select[name="questions[${i}][correct]"]`).value;
            }

            questions.push({ type, question, marks, options, correct });
        }

        const url = filename ? `/course/${subject}/assignments/${filename}` : '/assignment/save';
        const method = filename ? 'PUT' : 'POST';

        fetch(url, {
            method: method,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ title, questions, filename, subject, deadline, isTimed, timeLimit })
        })
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    document.getElementById('successMessage').textContent = `Assignment ${filename ? 'updated' : 'created'} successfully!`;
                    const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                    successModal.show();
                    closeModal('createAssignmentModal');
                    setTimeout(() => location.reload(), 1500); // optional auto-reload
                } else {
                    throw new Error(data.message || 'Operation failed');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById('errorMessage').textContent = `Failed to ${filename ? 'update' : 'create'} assignment: ${error.message}`;
                const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                errorModal.show();
            });
    }



    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }
</script>

<!-- Upgrade Modal -->
