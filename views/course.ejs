<%- include('header.ejs') %>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- Add this helper function at the top of your EJS file -->
<% function truncateText(text, maxLength) {
    if (text.length > maxLength) {
        return text.substring(0, maxLength) + '...';
    }
    return text;
} %>

<div class="lecture-dashboard">
    <!-- Header Section -->
    <div class="dashboard-header">
        <h1><i class="fas fa-chalkboard-teacher"></i> <%= subject %> Learning Materials</h1>
        <p class="subtitle">Access lecture slides, generate study aids, and manage your personal notes</p>
    </div>

    <!-- Main Content Tabs -->
    <div class="dashboard-tabs">
        <div class="tab-nav">
            <button class="tab-btn active" onclick="openTab('official-slides')">Official Slides</button>
            <button class="tab-btn" onclick="openTab('personal-notes')">Personal Notes</button>
            <button class="tab-btn" onclick="openTab('upload-section')">Upload Notes</button>
            <button class="tab-btn" onclick="openTab('assignment-section')">Assignments</button>
        </div>

        <!-- Official Slides Tab -->
        <div id="official-slides" class="tab-content active-tab">
            <div class="section-header">
                <h2><i class="fas fa-file-pdf"></i> Lecture Slides</h2>
                <p>Course-provided presentation materials</p>
            </div>

            <% if (slides.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-folder-open"></i>
                    <p>No slides available for this course</p>
                </div>
            <% } else { %>
                <div class="lecture-grid">
                    <% slides.forEach((slide, index) => { %>
                        <div class="lecture-card">
                            <div class="lecture-info">
                                <div class="lecture-number">Lecture <%= index + 1 %></div>
                                <h3 title="<%= slide.replace('.pdf', '') %>">
                                    <%= truncateText(slide.replace('.pdf', ''), 50) %>
                                </h3>
                            </div>
                            <div class="lecture-actions">
                                <a href="/Course/<%= subject %>/slides/<%= encodeURIComponent(slide) %>" target="_blank" class="action-btn download">
                                    <i class="fas fa-download"></i> Download
                                </a>
                                <a href="/pdfview/<%= encodeURIComponent(slide) %>" class="action-btn view">
                                    <i class="fas fa-eye"></i> View
                                </a>
                                <% if (subscription_type === 'Enterprise') { %>
                                    <div class="premium-actions">
                                        <a href="/generateQuestions/<%= encodeURIComponent(slide) %>" class="action-btn premium">
                                            <i class="fas fa-bolt"></i> Flashcards
                                        </a>
                                        <a href="/summarize/<%= encodeURIComponent(slide) %>" class="action-btn premium">
                                            <i class="fas fa-file-alt"></i> Summary
                                        </a>
                                    </div>
                                <% } else { %>
                                    <div class="premium-locked">
                                        <button class="action-btn locked" onclick="showUpgradePopup()">
                                            <i class="fas fa-crown"></i> Upgrade for More
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <!-- Personal Notes Tab -->
        <div id="personal-notes" class="tab-content">
            <div class="section-header">
                <h2><i class="fas fa-user-edit"></i> Personal Notes</h2>
                <p>Your uploaded study materials</p>
            </div>

            <% if (personalslides.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-upload"></i>
                    <p>You haven't uploaded any personal notes yet</p>
                    <button class="primary-btn" onclick="openTab('upload-section')">
                        <i class="fas fa-plus"></i> Upload Notes
                    </button>
                </div>
            <% } else { %>
                <div class="lecture-grid">
                    <% personalslides.forEach((slide, index) => { %>
                        <div class="lecture-card <%= slide.isApproved !== 'Approved' ? 'pending' : '' %>">
                            <div class="lecture-info">
                                <div class="lecture-number">Note <%= index + 1 %></div>
                                <h3 title="<%= slide.file_path ? slide.file_path.replace('.pdf', '') : 'Untitled' %>">
                                    <%= truncateText(slide.file_path ? slide.file_path.replace('.pdf', '') : 'Untitled', 50) %>
                                </h3>
                                <div class="status-badge <%= slide.isApproved.toLowerCase() %>">
                                    <% if (slide.isApproved === 'Approved') { %>
                                        <i class="fas fa-check-circle"></i> Approved
                                    <% } else if (slide.isApproved === 'Declined') { %>
                                        <i class="fas fa-times-circle"></i> Declined
                                    <% } else { %>
                                        <i class="fas fa-hourglass-half"></i> Pending
                                    <% } %>
                                </div>
                            </div>

                            <% if (slide.isApproved === 'Approved') { %>
                                <div class="lecture-actions">
                                    <a href="/Workstation/<%= userid %>/<%= subject %>/slides/<%= encodeURIComponent(slide.file_path) %>" target="_blank" class="action-btn download">
                                        <i class="fas fa-download"></i> Download
                                    </a>
                                    <a href="/pdfview/<%= slide.file_path %>" class="action-btn view">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <% if (subscription_type === 'Enterprise') { %>
                                        <div class="premium-actions">
                                            <a href="/generateQuestions/<%= slide.file_path %>" class="action-btn premium">
                                                <i class="fas fa-bolt"></i> Flashcards
                                            </a>
                                            <a href="/summarize/<%= slide.file_path %>" class="action-btn premium">
                                                <i class="fas fa-file-alt"></i> Summary
                                            </a>
                                        </div>
                                    <% } else { %>
                                        <div class="premium-locked">
                                            <button class="action-btn locked" onclick="showUpgradePopup()">
                                                <i class="fas fa-crown"></i> Upgrade for More
                                            </button>
                                        </div>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <!-- Upload Section Tab -->
        <div id="upload-section" class="tab-content">
            <div class="upload-container">
                <div class="upload-card">
                    <div class="upload-header">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <h2>Upload Personal Notes</h2>
                        <p>Share your study materials in PDF format</p>
                    </div>
                    <form action="/uploadPdf" method="POST" enctype="multipart/form-data" class="upload-form">
                        <div class="file-upload">
                            <input type="file" id="pdfFile" name="pdfFile" accept="application/pdf" required>
                            <label for="pdfFile">
                                <i class="fas fa-file-pdf"></i>
                                <span>Choose PDF File</span>
                            </label>
                        </div>
                        <button type="submit" class="primary-btn upload-btn">
                            <i class="fas fa-upload"></i> Upload Notes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Assignment Section Tab -->
        <div id="assignment-section" class="tab-content">
            <div class="section-header">
                <h2><i class="fas fa-tasks"></i> Assignments</h2>
                <p>View and submit your course assignments</p>
            </div>

            <% if (locals.isAdmin) { %>
                <!-- Admin View -->
                <div class="admin-assignment-controls">
                    <button class="primary-btn" onclick="showCreateAssignmentModal()">
                        <i class="fas fa-plus"></i> Create New Assignment
                    </button>

                    <% if (assignments.length > 0) { %>
                        <div class="assignment-list mt-4">
                            <h3>Existing Assignments</h3>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Questions</th>
                                        <th>Total Marks</th>
                                        <th>Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <% assignments.forEach(assignment => { %>
                                        <tr>
                                            <td><%= assignment.title %></td>
                                            <td><%= assignment.questionCount %></td>
                                            <td><%= assignment.totalMarks %></td>
                                            <td>
                                                <button class="btn btn-sm btn-primary"
                                                        onclick="viewAssignment('<%= assignment.filename %>')">
                                                    <i class="fas fa-eye"></i> View
                                                </button>
                                                <button class="btn btn-sm btn-danger"
                                                        onclick="deleteAssignment('<%= assignment.filename %>')">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="empty-state mt-4">
                            <i class="fas fa-tasks fa-3x"></i>
                            <p class="mt-3">No assignments created yet</p>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <!-- Student View -->
                <% if (assignments.length > 0) { %>
                    <div class="assignment-list mt-4">
                        <div class="row">
                            <% assignments.forEach(assignment => { %>
                                <div class="col-md-6 mb-4">
                                    <div class="card assignment-card">
                                        <div class="card-body">
                                            <h5 class="card-title"><%= assignment.title %></h5>
                                            <p class="card-text">
                                            <span class="badge bg-primary">
                                                <%= assignment.questionCount %> questions
                                            </span>
                                                                        <span class="badge bg-success ms-2">
                                                <%= assignment.totalMarks %> total marks
                                            </span>
                                            </p>

                                            <% if (assignment.attempted) { %>
                                                <div class="alert alert-info">
                                                    Completed - Grade: <%= assignment.grade %>%
                                                </div>
                                            <% } else { %>
                                                <button class="btn btn-primary"
                                                        onclick="viewAssignment('<%= assignment.filename %>')">
                                                    <i class="fas fa-eye"></i> View Assignment
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } else { %>
                    <div class="empty-state mt-4">
                        <i class="fas fa-tasks fa-3x"></i>
                        <p class="mt-3">No assignments available for this course yet</p>
                    </div>
                <% } %>
            <% } %>
        </div>

    </div>
</div>



<!-- New ends here -->
<!-- Add this modal at the bottom of your course.ejs file, before the closing body tag -->
<!-- Create Assignment Modal -->
<div id="createAssignmentModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3><%= existingAssignment ? "Edit Assignment" : "Create Assignment" %></h3>
            <span class="close" onclick="closeModal('createAssignmentModal')">&times;</span>
        </div>
        <div class="modal-body">
            <form id="assignmentForm">
                <div class="form-group">
                    <label>Assignment Title:</label>
                    <input type="text" class="form-control" name="title" id="assignmentTitle" required>
                </div>
                <div id="questions" class="questions-container"></div>
                <div class="form-group text-center mt-3">
                    <button type="button" class="btn btn-outline-primary" onclick="addQuestion()">
                        <i class="fas fa-plus"></i> Add Question
                    </button>
                </div>
                <input type="hidden" id="filename" value="<%= filename || '' %>">
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('createAssignmentModal')">Cancel</button>
            <button class="btn btn-primary" onclick="submitAssignment()">Save Assignment</button>
        </div>
    </div>
</div>

<script>
    //viewing java
    function viewAssignment(filename) {
        // Get the subject from EJS rendering
        const subject = '<%= subject %>';
        const cleanFilename = filename.replace(/\.json$/i, '');

        // Debug output
        //alert(`Viewing assignment: ${cleanFilename} for subject: ${subject}`);
        console.log(`Viewing assignment: ${cleanFilename} for subject: ${subject}`);

        // Construct the URL
        const url = `/Course/${subject}/assignments/${encodeURIComponent(cleanFilename)}`;
        console.log('Navigating to:', url);
        //alert(`Navigating to: ${url}`);

        window.location.href = url;
    }

    function deleteAssignment(filename) {
        if (confirm('Are you sure you want to delete this assignment?')) {
            fetch(`/course/<%= subject %>/assignments/${filename}`, {
                method: 'DELETE'
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + (data.message || 'Failed to delete assignment'));
                    }
                })
                .catch(err => {
                    console.error("Error deleting assignment:", err);
                    alert('Failed to delete assignment');
                });
        }
    }



    // Assignment-related JavaScript
    const existingAssignment = <%- JSON.stringify(existingAssignment || null) %>;
    const assignmentFilename = "<%= filename || '' %>";
    let questionIndex = 0;

    function showCreateAssignmentModal() {
        document.getElementById('questions').innerHTML = '';
        questionIndex = 0;
        document.getElementById('assignmentTitle').value = '';

        if (existingAssignment && existingAssignment.questions) {
            document.getElementById("assignmentTitle").value = existingAssignment.title || "";
            existingAssignment.questions.forEach(q => addQuestion(q));
        }

        document.getElementById('createAssignmentModal').style.display = 'block';
    }

    function addQuestion(existing = null) {
        const container = document.getElementById("questions");
        const qDiv = document.createElement("div");
        qDiv.className = "question-block";
        qDiv.dataset.index = questionIndex;
        qDiv.id = `question-${questionIndex}`;

        const type = existing?.type || "mcq";
        const questionText = existing?.question || "";
        const marks = existing?.marks || "";

        qDiv.innerHTML = `
            <div class="question-header">
                <h5>Question ${questionIndex + 1}</h5>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeQuestion(${questionIndex})">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
            <div class="form-group">
                <label>Question Type:</label>
                <select class="form-control" name="questions[${questionIndex}][type]" onchange="updateOptions(this)">
                    <option value="mcq" ${type === "mcq" ? "selected" : ""}>Multiple Choice</option>
                    <option value="truefalse" ${type === "truefalse" ? "selected" : ""}>True/False</option>
                    <option value="written" ${type === "written" ? "selected" : ""}>Written Answer</option>
                </select>
            </div>
            <div class="form-group">
                <label>Question:</label>
                <textarea class="form-control" name="questions[${questionIndex}][question]" rows="3" required>${questionText}</textarea>
            </div>
            <div class="options"></div>
            <div class="form-group">
                <label>Marks:</label>
                <input type="number" class="form-control" name="questions[${questionIndex}][marks]" value="${marks}" required>
            </div>
        `;

        container.appendChild(qDiv);
        const optionsDiv = qDiv.querySelector(".options");
        addOptionsBlock(optionsDiv, type, questionIndex, existing);
        questionIndex++;
    }

    function removeQuestion(index) {
        const question = document.getElementById(`question-${index}`);
        if (question) {
            question.remove();
        }
    }

    function updateOptions(select) {
        const block = select.closest(".question-block");
        const index = block.dataset.index;
        const optionsDiv = block.querySelector(".options");
        optionsDiv.innerHTML = "";
        addOptionsBlock(optionsDiv, select.value, index);
    }

    function addOptionsBlock(container, type, qIndex, existing = null) {
        if (type === "mcq") {
            const opts = existing?.options || [];
            const correct = existing?.correct || "A";
            let html = `<div class="form-group">
                <label>Options:</label>
                <div class="option-list" id="option-list-${qIndex}">`;

            for (let i = 0; i < Math.max(opts.length, 2); i++) {
                html += renderLabeledOption(qIndex, i, opts[i] || "");
            }

            html += `</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addOption(${qIndex})">
                    <i class="fas fa-plus"></i> Add Option
                </button>
                <div class="form-group mt-2">
                    <label>Correct Answer:</label>
                    <select class="form-control" name="questions[${qIndex}][correct]" id="correct-select-${qIndex}" required>`;

            for (let i = 0; i < Math.max(opts.length, 2); i++) {
                const letter = String.fromCharCode(65 + i);
                html += `<option value="${letter}" ${correct === letter ? "selected" : ""}>${letter}</option>`;
            }

            html += `</select>
                </div>
            </div>`;
            container.innerHTML = html;
        } else if (type === "truefalse") {
            const correct = existing?.correct || "True";
            container.innerHTML = `
                <div class="form-group">
                    <label>Options:</label>
                    <ul class="list-unstyled">
                        <li>A. True</li>
                        <li>B. False</li>
                    </ul>
                </div>
                <div class="form-group">
                    <label>Correct Answer:</label>
                    <select class="form-control" name="questions[${qIndex}][correct]" required>
                        <option value="True" ${correct === "True" ? "selected" : ""}>True</option>
                        <option value="False" ${correct === "False" ? "selected" : ""}>False</option>
                    </select>
                </div>
            `;
        } else {
            container.innerHTML = ""; // Written answer has no options or correct answer
        }
    }

    function renderLabeledOption(qIndex, optIndex, value = "") {
        const letter = String.fromCharCode(65 + optIndex);
        return `
            <div class="input-group mb-2">
                <div class="input-group-prepend">
                    <span class="input-group-text">${letter}.</span>
                </div>
                <input type="text" class="form-control" name="questions[${qIndex}][options][]" value="${value}"
                       oninput="refreshCorrectOptions(${qIndex})" required>
            </div>`;
    }

    function addOption(qIndex) {
        const list = document.getElementById(`option-list-${qIndex}`);
        const count = list.querySelectorAll("input").length;
        const letter = String.fromCharCode(65 + count);

        const optionDiv = document.createElement('div');
        optionDiv.className = 'input-group mb-2';
        optionDiv.innerHTML = `
            <div class="input-group-prepend">
                <span class="input-group-text">${letter}.</span>
            </div>
            <input type="text" class="form-control" name="questions[${qIndex}][options][]"
                   oninput="refreshCorrectOptions(${qIndex})" required>
        `;

        list.appendChild(optionDiv);
        refreshCorrectOptions(qIndex);
    }

    function refreshCorrectOptions(qIndex) {
        const list = document.getElementById(`option-list-${qIndex}`);
        const inputs = list.querySelectorAll("input");
        const select = document.getElementById(`correct-select-${qIndex}`);
        if (!select) return;
        select.innerHTML = "";
        inputs.forEach((input, i) => {
            const letter = String.fromCharCode(65 + i);
            const option = document.createElement("option");
            option.value = letter;
            option.textContent = letter;
            select.appendChild(option);
        });
    }

    function submitAssignment() {
        const title = document.getElementById('assignmentTitle').value;
        const filename = document.getElementById('filename').value; // Will be empty for new assignments
        const questions = [];
        const subject = '<%= subject %>';

        // Collect all questions
        for (let i = 0; i < questionIndex; i++) {
            const block = document.getElementById(`question-${i}`);
            if (!block) continue;

            const type = block.querySelector(`select[name="questions[${i}][type]"]`).value;
            const question = block.querySelector(`textarea[name="questions[${i}][question]"]`).value;
            const marks = parseInt(block.querySelector(`input[name="questions[${i}][marks]"]`).value);

            let options = [];
            let correct = null;

            if (type === "mcq") {
                const optionInputs = block.querySelectorAll(`input[name="questions[${i}][options][]"]`);
                optionInputs.forEach(input => options.push(input.value));
                correct = block.querySelector(`select[name="questions[${i}][correct]"]`).value;
            } else if (type === "truefalse") {
                correct = block.querySelector(`select[name="questions[${i}][correct]"]`).value;
            }

            questions.push({ type, question, marks, options, correct });
        }

        // Determine if we're creating or updating
        const url = filename ? `/course/${subject}/assignments/${filename}` : '/assignment/save';
        const method = filename ? 'PUT' : 'POST';

        fetch(url, {
            method: method,
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ title, questions, filename, subject })
        })
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    alert(`Assignment ${filename ? 'updated' : 'created'} successfully!`);
                    closeModal('createAssignmentModal');
                    location.reload();
                } else {
                    throw new Error(data.message || 'Operation failed');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert(`Failed to ${filename ? 'update' : 'create'} assignment: ${error.message}`);
            });
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }
</script>

