<%- include('header.ejs') %>

<h1>Admin Dashboard</h1>

<% if (unapprovedDocuments.length > 0) { %>
    <h3>Unapproved Documents</h3>

    <div class="documents-container">
        <% unapprovedDocuments.forEach(doc => { %>
            <div class="document-card">
                <p><strong>Document:</strong> <%= doc.file_name %></p>
                <p><strong>Path:</strong> <%= doc.file_directory %></p>

                <div class="button-group">
                    <!-- View Button -->
                    <a href="/view-document?path=<%= doc.file_directory %>/<%= encodeURIComponent(doc.file_name) %>"
                       target="_blank" class="btn btn-sm btn-brown mr-2 view-btn">
                        <i class="bi bi-eye"></i> View
                    </a>

                    <!-- Approve & Decline Buttons -->
                    <button class="approve-btn" onclick="approveDocument('<%= doc.file_name %>')">Approve</button>
                    <button class="decline-btn" onclick="declineDocument('<%= doc.file_name %>')">Decline</button>
                </div>
            </div>
        <% }) %>
    </div>

<% } else { %>
    <p class="no-documents">No documents pending approval.</p>
<% } %>

<%- include('footer.ejs') %>

<!-- JavaScript for Approve & Decline -->
<script>
    function approveDocument(fileName) {
        fetch(`/admin/approve/${encodeURIComponent(fileName)}`, { method: 'POST' })
            .then(() => {

                location.reload();
            })
            .catch(() => alert("Failed to approve document."));
    }

    function declineDocument(fileName) {
        fetch(`/admin/decline/${encodeURIComponent(fileName)}`, { method: 'POST' })
            .then(() => {

                location.reload();
            })
            .catch(() => alert("Failed to decline document."));
    }
</script>

<!-- CSS Styles -->
<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
        color: #333;
        margin: 0;
        padding: 20px;
    }

    h1 {
        color: #8B4513;
        text-align: center;
    }

    h3 {
        color: #8B4513;
        margin-bottom: 15px;
    }

    .documents-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .document-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 15px;
        width: 350px;
        border-left: 5px solid #8B4513;
    }

    .document-card p {
        margin: 8px 0;
    }

    .button-group {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
    }

    /* Button styles */
    .btn-brown {
        background-color: #8B4513;
        color: white;
        padding: 8px 12px;
        border-radius: 5px;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-brown i {
        font-size: 18px;
    }

    .approve-btn {
        background-color: #4CAF50;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 5px;
        cursor: pointer;
    }

    .decline-btn {
        background-color: #FF5733;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-brown:hover, .approve-btn:hover, .decline-btn:hover {
        opacity: 0.8;
    }

    .no-documents {
        text-align: center;
        font-size: 18px;
        color: gray;
    }
</style>
