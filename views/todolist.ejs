<%- include('header.ejs') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<div class="todo-app">
    <div class="todo-header">
        <h1 class="todo-title"><i class="fas fa-list-check"></i> <%= listTitle %></h1>
        <p class="todo-stats"><span id="itemCount"><%= listItems.length %></span> items</p>
    </div>

    <div class="todo-list">
        <% for(let item of listItems) { %>
            <div class="todo-item <%= item.completed ? 'completed' : '' %>" data-id="<%= item.id %>">
                <div class="todo-item-content">
                    <form action="/deleteItem" method="post" class="todo-check-form">
                        <input type="hidden" name="deleteItemId" value="<%= item.id %>">
                        <button type="submit" class="todo-checkbox">
                            <i class="fas fa-check"></i>
                        </button>
                    </form>
                    <div class="todo-text" id="title<%= item.id %>"><%= item.title %></div>
                    <div class="todo-actions">
                        <button class="todo-edit-btn" onclick="handler('<%= item.id %>')">
                            <i class="fas fa-pencil-alt"></i>
                        </button>
                        <form action="/deleteItem" method="post" class="todo-delete-form">
                            <input type="hidden" name="deleteItemId" value="<%= item.id %>">
                            <button type="submit" class="todo-delete-btn">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
                <form class="todo-edit-form" action="/editItem" method="post">
                    <input type="hidden" name="updatedItemId" value="<%= item.id %>">
                    <input class="todo-edit-input" id="input<%= item.id %>" type="text" name="updatedItemTitle" value="<%= item.title %>" autocomplete="off" hidden>
                    <button class="todo-save-btn" id="done<%= item.id %>" type="submit" hidden>
                        <i class="fas fa-check"></i> Save
                    </button>
                </form>
            </div>
        <% } %>

        <form class="todo-add-form" action="/addItem" method="post">
            <input type="text" name="newItem" placeholder="Add a new task..." autocomplete="off" class="todo-add-input">
            <button class="todo-add-btn" type="submit" name="list" value="<%= listTitle %>">
                <i class="fas fa-plus"></i> Add
            </button>
        </form>
    </div>
</div>

<script>
    function handler(id) {
        document.getElementById("title" + id).style.display = "none";
        document.querySelector(`[data-id="${id}"] .todo-edit-btn`).style.display = "none";
        document.getElementById("input" + id).removeAttribute("hidden");
        document.getElementById("done" + id).removeAttribute("hidden");
        document.getElementById("input" + id).focus();
    }

    // Update item count
    document.addEventListener('DOMContentLoaded', () => {
        const itemCount = document.querySelectorAll('.todo-item').length;
        document.getElementById('itemCount').textContent = itemCount;
    });
</script>

<style>
    /* Modern Todo List Styles */
    :root {
        --primary-brown: #8B4513;
        --dark-brown: #5D4037;
        --light-brown: #D2B48C;
        --pale-beige: #F5F5DC;
        --off-white: #FFFDFA;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.12);
        --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
        --shadow-lg: 0 10px 25px rgba(139, 69, 19, 0.1);
        --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    * {
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
    }

    .todo-app {
        max-width: 800px;
        margin: 2rem auto;
        padding: 2rem;
        background: white;
        border-radius: 16px;
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--light-brown);
    }

    .todo-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--light-brown);
    }

    .todo-title {
        color: var(--dark-brown);
        font-size: 2rem;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .todo-stats {
        color: var(--primary-brown);
        margin: 0.5rem 0 0;
        font-size: 0.9rem;
        opacity: 0.8;
    }

    .todo-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .todo-item {
        background: var(--off-white);
        border-radius: 10px;
        padding: 1rem;
        transition: var(--transition);
        border: 1px solid rgba(139, 69, 19, 0.1);
    }

    .todo-item:hover {
        box-shadow: var(--shadow-sm);
    }

    .todo-item.completed {
        opacity: 0.7;
    }

    .todo-item.completed .todo-text {
        text-decoration: line-through;
        color: #888;
    }

    .todo-item-content {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .todo-check-form {
        margin: 0;
    }

    .todo-checkbox {
        width: 24px;
        height: 24px;
        border: 2px solid var(--light-brown);
        border-radius: 6px;
        background: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
    }

    .todo-checkbox:hover {
        border-color: var(--primary-brown);
    }

    .todo-checkbox i {
        color: var(--primary-brown);
        font-size: 0.8rem;
        opacity: 0;
        transition: var(--transition);
    }

    .todo-item.completed .todo-checkbox {
        background: var(--primary-brown);
        border-color: var(--primary-brown);
    }

    .todo-item.completed .todo-checkbox i {
        opacity: 1;
        color: white;
    }

    .todo-text {
        flex: 1;
        font-size: 1.1rem;
        color: var(--dark-brown);
        word-break: break-word;
    }

    .todo-actions {
        display: flex;
        gap: 0.5rem;
    }

    .todo-edit-btn, .todo-delete-btn {
        background: transparent;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: var(--transition);
        color: var(--dark-brown);
    }

    .todo-edit-btn:hover {
        background: rgba(139, 69, 19, 0.1);
        color: var(--primary-brown);
    }

    .todo-delete-btn:hover {
        background: rgba(220, 53, 69, 0.1);
        color: #dc3545;
    }

    .todo-edit-form {
        display: none;
        margin-top: 0.5rem;
    }

    .todo-edit-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid var(--light-brown);
        border-radius: 8px;
        font-size: 1rem;
        margin-bottom: 0.5rem;
    }

    .todo-edit-input:focus {
        outline: none;
        border-color: var(--primary-brown);
    }

    .todo-save-btn {
        padding: 0.5rem 1rem;
        background: var(--primary-brown);
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .todo-save-btn:hover {
        background: var(--dark-brown);
    }

    .todo-add-form {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .todo-add-input {
        flex: 1;
        padding: 0.75rem 1rem;
        border: 1px solid var(--light-brown);
        border-radius: 8px;
        font-size: 1rem;
    }

    .todo-add-input:focus {
        outline: none;
        border-color: var(--primary-brown);
    }

    .todo-add-btn {
        padding: 0.75rem 1.5rem;
        background: var(--primary-brown);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .todo-add-btn:hover {
        background: var(--dark-brown);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .todo-app {
            padding: 1.5rem;
            margin: 1rem;
        }

        .todo-title {
            font-size: 1.5rem;
        }

        .todo-add-form {
            flex-direction: column;
        }
    }
</style>

<%- include('footer.ejs') %>