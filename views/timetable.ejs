<%- include('header.ejs') %>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="timetable-container">
    <div class="timetable-header">
        <h1><i class="fas fa-calendar-alt"></i> Weekly Schedule</h1>
        <p>Manage your classes and study sessions</p>
    </div>

    <% if (locals.errorMessage) { %>
        <div class="alert-message error">
            <i class="fas fa-exclamation-circle"></i> <%= errorMessage %>
        </div>
    <% } %>

    <!-- Add Entry Form -->
    <div class="add-entry-card">
        <h2><i class="fas fa-plus-circle"></i> Add New Class</h2>
        <form action="/addSubject" method="POST" class="entry-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="day"><i class="fas fa-calendar-day"></i> Day</label>
                    <select name="day" id="day" required>
                        <% ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].forEach(day => { %>
                            <option value="<%= day %>"><%= day %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="startTime"><i class="fas fa-clock"></i> Start Time</label>
                    <select name="startTime" id="startTime" required>
                        <%
                        const startTimeSlots = [];
                        for (let h = 8; h < 18; h++) {
                            for (let m = 0; m < 60; m += 15) {
                                startTimeSlots.push(`${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`);
                            }
                        }
                        startTimeSlots.forEach(time => { %>
                            <option value="<%= time %>"><%= time %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="endTime"><i class="fas fa-clock"></i> End Time</label>
                    <select name="endTime" id="endTime" required>
                        <%
                        const endTimeSlots = [];
                        for (let h = 8; h < 18; h++) {
                            for (let m = 0; m < 60; m += 15) {
                                endTimeSlots.push(`${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`);
                            }
                        }
                        endTimeSlots.forEach(time => { %>
                            <option value="<%= time %>"><%= time %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="subject"><i class="fas fa-book"></i> Subject</label>
                    <input type="text" name="subject" id="subject" required>
                </div>

                <div class="form-group">
                    <label for="classType"><i class="fas fa-chalkboard-teacher"></i> Class Type</label>
                    <select name="classType" id="classType" required>
                        <option value="Lecture">Lecture</option>
                        <option value="Practice">Practice</option>
                        <option value="Lab">Lab</option>
                    </select>
                </div>

                <div class="form-group color-picker">
                    <label for="color"><i class="fas fa-palette"></i> Color</label>
                    <input type="color" name="color" id="color" value="#4361ee">
                </div>
            </div>

            <button type="submit" class="primary-btn">
                <i class="fas fa-plus"></i> Add Class
            </button>
        </form>
    </div>

    <!-- Timetable Display -->
    <div class="timetable-wrapper">
        <div class="timetable-grid">
            <!-- Time Column -->
            <div class="time-column">
                <div class="time-header">Time</div>
                <%
                const timeslots = [];
                for (let h = 8; h < 18; h++) {
                    for (let m = 0; m < 60; m += 15) {
                        timeslots.push(`${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`);
                    }
                }

                timeslots.forEach(time => { %>
                    <div class="time-cell" data-time="<%= time %>"><%= time %></div>
                <% }) %>
            </div>

            <!-- Day Columns -->
            <%
            const timetableGrid = {};
            const classEntries = {};
            ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].forEach(day => {
                timetableGrid[day] = timeslots.map(() => null);
            });

            timetable.forEach(entry => {
                const startIdx = timeslots.indexOf(entry.starttime);
                const endIdx = timeslots.indexOf(entry.endtime);
                if (startIdx !== -1 && endIdx !== -1) {
                    const duration = endIdx - startIdx;
                    if (!classEntries[entry.day]) classEntries[entry.day] = {};
                    classEntries[entry.day][entry.starttime] = {
                        subject: entry.subject,
                        classType: entry.classtype,
                        startTime: entry.starttime,
                        endTime: entry.endtime,
                        duration: duration,
                        color: entry.color || '#4361ee',
                        id: entry.id
                    };

                    for (let i = startIdx; i < endIdx; i++) {
                        timetableGrid[entry.day][i] = entry.starttime;
                    }
                }
            });
            %>

            <% ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].forEach(day => { %>
                <div class="day-column" data-day="<%= day %>">
                    <div class="day-header"><%= day %></div>
                    <% timeslots.forEach((time, rowIndex) => { %>
                        <% if (timetableGrid[day][rowIndex] === time) { %>
                            <% const entry = classEntries[day][time]; %>
                            <div class="class-cell"
                                 style="--class-color: <%= entry.color %>"
                                 data-duration="<%= entry.duration %>"
                                 data-id="<%= entry.id %>">
                                <div class="class-content">
                                    <div class="class-title"><%= entry.subject %></div>
                                    <div class="class-type"><%= entry.classType %></div>
                                    <div class="class-time"><%= entry.startTime %> - <%= entry.endTime %></div>
                                </div>
                                <button class="delete-btn" onclick="deleteClass('<%= entry.id %>')">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        <% } else if (!timetableGrid[day][rowIndex]) { %>
                            <div class="empty-cell"></div>
                        <% } %>
                    <% }) %>
                </div>
            <% }) %>
        </div>
    </div>
</div>

<style>
    /* Modern Timetable Styles */
    :root {
        --primary-brown: #8B4513;
        --dark-brown: #5D4037;
        --light-brown: #D2B48C;
        --pale-beige: #F5F5DC;
        --off-white: #FFFDFA;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.12);
        --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
        --shadow-lg: 0 10px 25px rgba(139, 69, 19, 0.1);
        --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    * {
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
    }

    .timetable-container {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    .timetable-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .timetable-header h1 {
        color: var(--dark-brown);
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    .timetable-header p {
        color: var(--primary-brown);
        font-size: 1.1rem;
        opacity: 0.8;
    }

    /* Alert Message */
    .alert-message {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-message.error {
        background: rgba(220, 53, 69, 0.1);
        color: #dc3545;
        border-left: 4px solid #dc3545;
    }

    /* Add Entry Form */
    .add-entry-card {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(139, 69, 19, 0.1);
    }

    .add-entry-card h2 {
        color: var(--dark-brown);
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .entry-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-row {
        display: flex;
        gap: 1.5rem;
    }

    .form-group {
        flex: 1;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: var(--dark-brown);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-group select,
    .form-group input[type="text"] {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 1rem;
        transition: var(--transition);
    }

    .form-group select:focus,
    .form-group input[type="text"]:focus {
        outline: none;
        border-color: var(--primary-brown);
        box-shadow: 0 0 0 3px rgba(139, 69, 19, 0.1);
    }

    .color-picker {
        display: flex;
        flex-direction: column;
    }

    .color-picker input[type="color"] {
        width: 100%;
        height: 40px;
        padding: 0;
        border: none;
        background: none;
        cursor: pointer;
    }

    .primary-btn {
        padding: 0.75rem 1.5rem;
        background: var(--primary-brown);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        align-self: flex-end;
    }

    .primary-btn:hover {
        background: var(--dark-brown);
        transform: translateY(-2px);
    }

    /* Timetable Grid */
    .timetable-wrapper {
        overflow-x: auto;
        margin-bottom: 2rem;
        border-radius: 12px;
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(139, 69, 19, 0.1);
    }

    .timetable-grid {
        display: grid;
        grid-template-columns: 100px repeat(5, 1fr);
        min-width: 1000px;
    }

    .time-column, .day-column {
        display: grid;
        grid-template-rows: 60px repeat(40, 30px);
    }

    .time-header, .day-header {
        background: var(--primary-brown);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .time-cell {
        background: var(--off-white);
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        color: #666;
    }

    .empty-cell {
        background: white;
        border-bottom: 1px solid #eee;
        border-right: 1px solid #eee;
    }

    .class-cell {
        background: rgba(var(--class-color-rgb), 0.1);
        border: 1px solid rgba(var(--class-color-rgb), 0.2);
        border-radius: 6px;
        margin: 2px;
        position: relative;
        grid-row-end: span var(--duration);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0.5rem;
    }

    .class-cell::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--class-color);
        border-radius: 4px 0 0 4px;
    }

    .class-content {
        flex: 1;
        padding: 0.25rem;
    }

    .class-title {
        font-weight: 600;
        color: var(--dark-brown);
        margin-bottom: 0.25rem;
        font-size: 0.9rem;
    }

    .class-type {
        font-size: 0.8rem;
        color: #666;
        margin-bottom: 0.25rem;
    }

    .class-time {
        font-size: 0.75rem;
        color: #888;
    }

    .delete-btn {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 24px;
        height: 24px;
        background: rgba(0, 0, 0, 0.1);
        border: none;
        border-radius: 50%;
        color: #666;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        transition: var(--transition);
    }

    .delete-btn:hover {
        background: rgba(220, 53, 69, 0.2);
        color: #dc3545;
    }

    /* Responsive Design */
    @media (max-width: 1200px) {
        .form-row {
            flex-direction: column;
            gap: 1rem;
        }
    }

    @media (max-width: 768px) {
        .timetable-container {
            padding: 0 1rem;
        }

        .add-entry-card {
            padding: 1.5rem;
        }
    }
</style>

<script>
    // Convert color hex to RGB for CSS variables
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.class-cell').forEach(cell => {
            const color = cell.style.getPropertyValue('--class-color');
            if (color) {
                const rgb = hexToRgb(color);
                cell.style.setProperty('--class-color-rgb', `${rgb.r}, ${rgb.g}, ${rgb.b}`);
            }

            // Set grid row span based on duration
            const duration = cell.getAttribute('data-duration');
            if (duration) {
                cell.style.gridRowEnd = `span ${duration}`;
            }
        });
    });

    function hexToRgb(hex) {
        // Remove # if present
        hex = hex.replace('#', '');

        // Parse r, g, b values
        const r = parseInt(hex.substring(0, 2), 16);
        const g = parseInt(hex.substring(2, 4), 16);
        const b = parseInt(hex.substring(4, 6), 16);

        return { r, g, b };
    }

    function deleteClass(id) {
        if (confirm('Are you sure you want to delete this class?')) {
            fetch('/deleteSubject', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `subjectID=${id}`
            })
                .then(response => {
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Error deleting class');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error deleting class');
                });
        }
    }
</script>

<%- include('footer.ejs') %>