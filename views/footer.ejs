<script>
    document.getElementById('newsletterForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const email = document.getElementById('newsletterEmail').value;
        const messageBox = document.getElementById('newsletterMessage');

        if (!email || !email.includes('@')) {
            messageBox.innerHTML = `<div class="alert alert-warning">Please enter a valid email address.</div>`;
            return;
        }

        try {
            const res = await fetch('/subscribe-newsletter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });

            const data = await res.json();
            messageBox.innerHTML = `<div class="alert alert-${data.success ? 'success' : 'warning'}">${data.message}</div>`;
        } catch (err) {
            messageBox.innerHTML = `<div class="alert alert-danger">Something went wrong. Please try again.</div>`;
        }
    });
</script>

